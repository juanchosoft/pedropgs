Options -Indexes
<FilesMatch "\.(ini|env|lock|log|sql|md|dist)$">
  Require all denied
</FilesMatch>
<FilesMatch "^(composer\.json|composer\.lock|package\.json|phpunit\.xml|phpstan\.neon)$">
  Require all denied
</FilesMatch>
RedirectMatch 404 ^(?:/pgscentrum)?/(docs|tests|storage)(/|$)
RedirectMatch 404 ^(?:/pgscentrum)?/vendor/.*\.(php|json|md)$
RedirectMatch 404 ^(?:/pgscentrum)?/(scratch|\.phpunit\.cache)(/|$)
RedirectMatch 404 ^(?:/pgscentrum)?/admin/(bootstrap_pgs\.php|classes/Pgs)(/|$)
